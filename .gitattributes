# Normalize line endings so the repo stays consistent between Windows and CI.
# Files are stored with LF in git and checked out natively on each platform.
* text=auto eol=lf

# Windows-only scripts must keep CRLF or they break.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary assets — never touch these.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.ttf  binary
*.otf  binary
*.jar  binary
*.keystore binary
